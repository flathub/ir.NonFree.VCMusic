{
  "app-id": "ir.NonFree.VCMusic",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "VCMusic",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--env=LADSPA_PATH=/app/lib/ladspa",
    "--socket=pulseaudio",
    "--filesystem=xdg-music"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "ladspa-sdk",
      "no-autogen": true,
      "subdir": "src",
      "make-install-args": [
        "INSTALL_PLUGINS_DIR=/app/lib/ladspa",
        "INSTALL_INCLUDE_DIR=/app/include",
        "INSTALL_BINARY_DIR=/app/bin"
      ],
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.ladspa.org/download/ladspa_sdk_1.17.tgz",
          "sha256": "27d24f279e4b81bd17ecbdcc38e4c42991bb388826c0b200067ce0eb59d3da5b"
        }
      ]
    },
    {
      "name": "rubberband",
      "buildsystem": "meson",
      "config-opts": [
        "-Dladspa=enabled",
        "-Dlv2=disabled",
        "-Dvamp=disabled",
        "-Dcmdline=disabled",
        "-Djni=disabled",
        "-Dtests=disabled",
        "-Dfft=builtin",
        "-Dresampler=builtin",
        "-Ddefault_library=shared"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/share/man"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://breakfastquay.com/files/releases/rubberband-4.0.0.tar.bz2",
          "sha256": "af050313ee63bc18b35b2e064e5dce05b276aaf6d1aa2b8a82ced1fe2f8028e9"
        }
      ]
    },
    {
      "name": "VCMusic",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/run/build/VCMusic/crystal/bin/"
      },
      "build-commands": [
        "VCMUSIC_LOCALE_LOCATION=/app/share/locale crystal build ./src/main.cr -o VCMusic --release",
        "make metainfo",
        "make desktop",
        "make mo PREFIX=/app"
      ],
      "post-install": [
        "install -D -m 0755 VCMusic /app/bin/VCMusic",
        "install -D -m 0644 data/ir.NonFree.VCMusic.desktop /app/share/applications/ir.NonFree.VCMusic.desktop",
        "install -D -m 0644 data/icons/hicolor/scalable/apps/ir.NonFree.VCMusic.svg /app/share/icons/hicolor/scalable/apps/ir.NonFree.VCMusic.svg",
        "install -D -m 0644 data/icons/hicolor/symbolic/ir.NonFree.VCMusic-symbolic.svg /app/share/icons/hicolor/symbolic/apps/ir.NonFree.VCMusic-symbolic.svg",
        "install -D -m 0644 data/ir.NonFree.VCMusic.metainfo.xml /app/share/metainfo/ir.NonFree.VCMusic.metainfo.xml"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/VC365/VCMusic.git",
          "tag": "v0.1.2-1",
          "commit": "be67a2ae712bd0764a572ab22b2466cb3b58b2a9"
        },
        {
          "type": "archive",
          "dest": "crystal/",
          "url": "https://github.com/crystal-lang/crystal/releases/download/1.21.1/crystal-1.21.1-1-linux-x86_64.tar.gz",
          "sha256": "08b5779df8cf280c4a799599862bbe4d42103ba082aa73429562713c8a9f3b43",
          "only_arches": [
            "x86_64"
          ]
        },
        {
          "type": "archive",
          "dest": "crystal/",
          "url": "https://github.com/crystal-lang/crystal/releases/download/1.21.1/crystal-1.21.1-1-linux-aarch64.tar.gz",
          "sha256": "a37365b79f58d4cd32b6113bbb9983e21eb41d233667e003c019520e3c245e49",
          "only_arches": [
            "aarch64"
          ]
        }
      ]
    }
  ]
}
